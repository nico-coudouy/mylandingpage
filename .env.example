# Obligatoria: clave de Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Recomendada: Upstash Redis para los límites de uso (Vercel las crea al conectar Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=

